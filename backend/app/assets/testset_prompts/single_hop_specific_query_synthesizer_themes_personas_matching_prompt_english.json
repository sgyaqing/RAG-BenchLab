  "language": "english",
  "instruction": "Given a list of themes and personas with their roles, associate each persona with relevant themes based on their role description.",
  "examples": [
    {
      "input": {
        "themes": [
          "Empathy",
          "Inclusivity",
          "Remote work"
        ],
        "personas": [
          {
            "name": "HR Manager",
            "role_description": "Focuses on inclusivity and employee support."
          },
          {
            "name": "Remote Team Lead",
            "role_description": "Manages remote team communication."
          }
        ]
      },
      "output": {
        "mapping": {
          "HR Manager": [
            "Inclusivity",
            "Empathy"
          ],
          "Remote Team Lead": [
            "Remote work",
            "Empathy"
          ]
        }
      }
    }
  ]
}
